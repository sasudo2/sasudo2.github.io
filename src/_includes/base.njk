<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description }}">
    <link rel="stylesheet" href="/style.css">
    <link rel="shortcut icon" href="/assets/icon/favicon.png">
    <title>{{ title }}</title>
</head>
<body>
    <header class="site-header">
        <div class="container nav-wrap">
            <a class="brand" href="/">Sanjay Shrestha</a>
            <nav class="site-nav" aria-label="Primary">
                <a {% if navCurrent == "home" %}aria-current="page" {% endif %}href="/">Home</a>
                <a {% if navCurrent == "about" %}aria-current="page" {% endif %}href="/about/">About</a>
                <a {% if navCurrent == "projects" %}aria-current="page" {% endif %}href="/projects/">Projects</a>
                <a {% if navCurrent == "blog" %}aria-current="page" {% endif %}href="/blog/">Blog</a>
                <a {% if navCurrent == "images" %}aria-current="page" {% endif %}href="/images/">Photography</a>
                <a {% if navCurrent == "contact" %}aria-current="page" {% endif %}href="/contact/">Contact</a>
                <a {% if navCurrent == "resume" %}aria-current="page" {% endif %}href="/resume/">Resume</a>
            </nav>
        </div>
    </header>

    {{ content | safe }}

    <footer class="site-footer">
        <div class="container footer-grid">
            <p>Sanjay Shrestha | Kathmandu, Nepal</p>
            <div class="footer-links" aria-label="Social links">
                <a href="mailto:sanjayashrestha777@gmail.com" aria-label="Email"><img class="icon" src="/assets/icon/mail.png" alt="Email"></a>
                <a href="https://www.linkedin.com/in/sanjay-shrestha-58b3b7275/" aria-label="LinkedIn"><img class="icon" src="/assets/icon/linkedin.png" alt="LinkedIn"></a>
                <a href="https://github.com/sasudo2" aria-label="GitHub"><img class="icon" src="/assets/icon/github.png" alt="GitHub"></a>
                <a href="https://www.instagram.com/cat_said_go/" aria-label="Instagram"><img class="icon" src="/assets/icon/instagram.png" alt="Instagram"></a>
            </div>
        </div>
    </footer>
</body>
</html>
